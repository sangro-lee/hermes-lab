{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Researcher Experiment Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "title",
    "research_question",
    "hypothesis",
    "baseline",
    "method",
    "code_commit",
    "data_version",
    "seed",
    "resources",
    "metrics",
    "success_criteria",
    "approval"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$",
      "description": "파일 이름(확장자 제외)과 같아야 함"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "research_question": {
      "type": "string",
      "minLength": 5
    },
    "hypothesis": {
      "type": "string",
      "minLength": 5
    },
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "code_commit": {
      "type": "string",
      "minLength": 1
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "config_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "실행할 정확한 명령어 (재현용)"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition",
        "gpu_count",
        "cpu_count",
        "memory",
        "time_limit"
      ],
      "properties": {
        "partition": {
          "type": "string",
          "minLength": 1
        },
        "gpu_count": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+[KMGT]?$"
        },
        "time_limit": {
          "type": "string",
          "pattern": "^([0-9]+-)?[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$",
          "description": "Slurm 형식: HH:MM:SS 또는 D-HH:MM:SS"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "approved_by",
              "approved_at"
            ]
          },
          "code_commit": {
            "pattern": "^[0-9a-f]{7,40}$"
          }
        }
      }
    }
  ]
}
